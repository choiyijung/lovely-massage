EXPECTED_PER_SITE = 1423
TITLE = re.compile(r'(<title\b[^>]*>)(.*?)(</title\s*>)', re.I | re.S)
META = re.compile(r'<meta\b[^>]*>', re.I | re.S)
ATTR = re.compile(r'\b(?:name|property)\s*=\s*(["\'])(.*?)\1', re.I | re.S)
CONTENT = re.compile(r'\bcontent\s*=\s*(["\'])(.*?)\1', re.I | re.S)
HEAD_END = re.compile(r'</head\s*>', re.I)
KEYS = ('description', 'og:title', 'og:description')
OPTIONAL = ('twitter:title', 'twitter:description')


def insist(ok, msg):
    if not ok:
        raise RuntimeError(msg)


def get_key(tag):
    for a in ATTR.finditer(tag):
        key = a.group(2).strip().lower()
        if key in KEYS + OPTIONAL:
            return key
    return None


def current_seo(source, where):
    t = TITLE.findall(source)
    insist(len(t) == 1, f'TITLE 수 확인: {where} ({len(t)})')
    title = html.unescape(re.sub(r'<[^>]+>', '', t[0][1])).strip()
    tags = collections.defaultdict(list)
    for m in META.finditer(source):
        key = get_key(m.group(0))
        if key:
            tags[key].append(m.group(0))
    insist(len(tags['description']) == 1, f'DESCRIPTION 수 확인: {where}')
    for key in KEYS + OPTIONAL:
        insist(len(tags[key]) <= 1, f'{key} 중복: {where}')
        for tag in tags[key]:
            insist(CONTENT.search(tag) is not None, f'{key} content 없음: {where}')
    desc = html.unescape(CONTENT.search(tags['description'][0]).group(2)).strip()
    insist(title and desc, f'기존 SEO 제목/설명 비어 있음: {where}')
    insist(HEAD_END.search(source) is not None, f'</head> 없음: {where}')
    return title, desc, tags


def region_from_original(title, where):
    # V3 title begins with a truthful Korean hierarchy, e.g.
    # '경기 안산시 단원구 고잔동 마사지 | 주변 지역 살펴보기'.
    subject = html.unescape(title.split('|', 1)[0]).strip()
    insist(subject.endswith('마사지'), f'지역 제목 구분 불가: {where} / {title}')
    full_name = subject[:-len('마사지')].strip()
    insist(full_name, f'지역명 추출 실패: {where}')
    tail = full_name.split()[-1]
    insist(re.search(r'[가-힣]', tail) is not None, f'지역명 확인 필요: {where} / {full_name}')
    return full_name, tail


def combination(index):
    # 731 is coprime to 35,280: deterministic non-repeating permutation.
    k = (index * 731) % TOTAL_COMBINATIONS
    a = k % len(FIRST)
    b = (k // len(FIRST)) % len(SECOND)
    c = (k // (len(FIRST) * len(SECOND))) % len(THIRD)
    return FIRST[a], SECOND[b], THIRD[c], (a, b, c)


def generate(index, brand, old_title, relative):
    full, short = region_from_original(old_title, relative)
    a, b, c, triple = combination(index)
    title = f'{short} 마사지 | {a} | {b} | {c} | {brand}'
    # Each site uses a different lead, and each page's distinct chosen phrases
    # are reflected in its meta description without asserting unknown prices/hours.
    leads = [
        f'{full}에서 마사지 관련 지역정보를 살펴보세요.',
        f'{full} 마사지 안내를 찾고 있다면 이 지역의 연결 경로를 확인해 보세요.',
        f'{full}의 마사지 페이지를 통해 세부 지역정보를 둘러볼 수 있습니다.',
        f'{full} 마사지 정보를 알아볼 때 지역 안내부터 확인해 보세요.',
        f'{full}에 연결된 마사지 안내를 차례로 찾아보세요.',
        f'{full} 마사지 관련 정보를 살펴볼 수 있는 지역 페이지입니다.',
        f'{full}의 마사지 안내를 통해 필요한 상세페이지를 찾아보세요.',
        f'{full}에서 마사지 정보를 찾아갈 때 지역 분류를 확인해 보세요.',
    ]
    lead = leads[index // EXPECTED_PER_SITE]
    def particle(word, consonant, vowel):
        last = word[-1]
        code = ord(last) - 0xAC00
        return consonant if 0 <= code < 11172 and code % 28 else vowel
    a_with = a + particle(a, '과', '와')
    b_obj = b + particle(b, '을', '를')
    a_obj = a + particle(a, '을', '를')
    endings = [
        f'{a_with} {b_obj} 살펴보고 관련 정보를 찾아보세요. {c}도 참고할 수 있습니다.',
        f'{a} 및 {b} 등 관심 있는 주제를 중심으로 관련 안내를 살펴보세요. {c}도 확인해 보세요.',
        f'지역 안내를 보며 {a_obj} 확인하고 {b} 관련 정보로 이동해 보세요. {c}도 참고하세요.',
        f'{a}, {b} 항목을 알아보려면 연결된 안내를 확인하세요. {c}도 함께 살펴보세요.',
        f'지역을 선택한 뒤 {a_with} {b_obj} 차례로 확인해 보세요. {c}도 참고하세요.',
        f'{a_obj} 살펴보고 필요한 경우 {b} 관련 안내를 확인하세요. {c}도 참고할 수 있습니다.',
        f'관련 페이지에서 {b} 정보를 찾아보고 {a}도 함께 살펴보세요. {c}도 알아보세요.',
        f'관심 있는 내용이 {a} 또는 {b}라면 지역 안내를 확인해 보세요. {c}도 참고하세요.',
    ]
    desc = lead + ' ' + endings[index % len(endings)]
    insist(len(title) <= 145, f'제목 길이 {len(title)}: {relative} / {title}')
    insist(70 <= len(desc) <= 300, f'설명 길이 {len(desc)}: {relative} / {desc}')
    return title, desc, triple


def change_seo(source, title, desc, where):
    source = TITLE.sub(lambda m: m.group(1) + html.escape(title, quote=False) + m.group(3), source, count=1)
    present = set()
    def edit_meta(m):
        tag = m.group(0)
        key = get_key(tag)
        if not key:
            return tag
        present.add(key)
        c = CONTENT.search(tag)
        insist(c is not None, f'content 없음: {where} / {key}')
        value = title if key.endswith('title') else desc
        return tag[:c.start(2)] + html.escape(value, quote=True) + tag[c.end(2):]
    source = META.sub(edit_meta, source)
    missing = []
    for key in ('og:title', 'og:description'):
        if key not in present:
            value = title if key.endswith('title') else desc
            missing.append(f'<meta property="{key}" content="{html.escape(value, quote=True)}">')
    if missing:
        source = HEAD_END.sub(lambda m: '  ' + '\n  '.join(missing) + '\n' + m.group(0), source, count=1)
    actual_title, actual_desc, tags = current_seo(source, where)
    insist((actual_title, actual_desc) == (title, desc), f'TITLE/DESCRIPTION 불일치: {where}')
    for key, value in (('og:title', title), ('og:description', desc)):
        insist(len(tags[key]) == 1, f'{key} 누락: {where}')
        insist(html.unescape(CONTENT.search(tags[key][0]).group(2)) == value,
               f'{key} 값 불일치: {where}')
    return source


def get_plan(root):
    insist(root.is_dir(), f'사이트 폴더 없음: {root}')
    insist(root.resolve() not in (Path(r'E:\massage-auto-test').resolve(),
                                  Path(r'E:\seoul-massage-rebuild').resolve()), '원본/운영 사이트는 수정하지 않습니다')
    result = []
    triples = set()
    normalized_titles = set()
    normalized_descs = set()
    index = 0
    sample = []
    for slug, brand in SITES:
        folder = root / slug
        insist(folder.is_dir(), f'사이트 없음: {folder}')
        pages = sorted((folder / 'massage').rglob('index.html'))
        insist(len(pages) == EXPECTED_PER_SITE,
               f'{brand}: massage 지역페이지 예상 1,423 / 실제 {len(pages)}')
        for path in pages:
            rel = path.relative_to(folder).as_posix()
            raw = path.read_bytes()
            source = raw.decode('utf-8-sig')
            old_title, old_desc, _ = current_seo(source, f'{slug}/{rel}')
            new_title, new_desc, triple = generate(index, brand, old_title, rel)
            changed = change_seo(source, new_title, new_desc, f'{slug}/{rel}')
            insist(changed != source, f'이미 적용됐거나 수정 없음: {slug}/{rel}')
            insist(triple not in triples, f'조합 중복: {slug}/{rel}')
            triples.add(triple)
            subject = new_title.split(' 마사지 |', 1)[-1].replace(brand, '[브랜드]')
            insist(subject not in normalized_titles, f'문구 조합 중복: {slug}/{rel}')
            normalized_titles.add(subject)
            insist(new_desc not in normalized_descs, f'설명 중복: {slug}/{rel}')
            normalized_descs.add(new_desc)
            result.append((path, hashlib.sha256(raw).digest(), slug, rel, new_title, new_desc))
            if rel in ('massage/gyeonggi/ansan/danwon-gu/index.html',
                       'massage/gyeonggi/ansan/danwon-gu/고잔동/index.html'):
                sample.append((brand, rel, new_title, new_desc))
            index += 1
        print(f'사전검사: {brand} / 1,423페이지 / 누적 {index:,}', flush=True)
    insist(index == 11384 and len(triples) == index and index < TOTAL_COMBINATIONS,
           f'대상 또는 조합 수 오류: {index}')
    return result, sample


def make_backup(plan, root):
    now = datetime.now().strftime('%Y%m%d_%H%M%S')
    bak = root / f'massage_region_seo_8sites_before_{now}.zip'
    tmp = root / f'massage_region_seo_8sites_before_{now}.zip.partial'
    insist(not bak.exists() and not tmp.exists(), '백업 이름 충돌')
    total_bytes = sum(path.stat().st_size for path, *_ in plan)
    insist(shutil.disk_usage(root).free > total_bytes * 2 + 100_000_000,
           '백업 및 수정 공간 부족')
    with zipfile.ZipFile(tmp, 'x', compression=zipfile.ZIP_DEFLATED,
                         compresslevel=1, allowZip64=True) as z:
        for n, (path, digest, *_rest) in enumerate(plan, 1):
            raw = path.read_bytes()
            insist(hashlib.sha256(raw).digest() == digest,
                   f'백업 중 파일 변경: {path}')
            z.writestr(path.relative_to(root).as_posix(), raw)
            if n % 2000 == 0:
                print(f'백업 중: {n:,}/{len(plan):,}', flush=True)
    with zipfile.ZipFile(tmp) as z:
        insist(len(z.namelist()) == len(plan) and z.testzip() is None,
               'ZIP 백업 검증 실패')
    os.replace(tmp, bak)
    print('백업 완료:', bak, flush=True)
    return bak


def atomic_write(path, content):
    tmp = path.with_name(path.name + '.massage-region-seo.tmp')
    insist(not tmp.exists(), f'기존 임시 파일: {tmp}')
    try:
        with tmp.open('xb') as file:
            file.write(content.encode('utf-8'))
            file.flush()
            os.fsync(file.fileno())
        os.replace(tmp, path)
    finally:
        if tmp.exists():
            tmp.unlink()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--root', default=str(ROOT_DEFAULT))
    parser.add_argument('--apply', action='store_true')
    args = parser.parse_args()
    root = Path(args.root).resolve()
    marker = root / 'massage_region_seo_8sites_done.json'
    insist(not marker.exists(), '완료 표시가 있습니다. 재실행하지 마세요')
    print('일반 massage 지역페이지만 수정합니다. 상품·special·메인·기타는 제외합니다.', flush=True)
    plan, sample = get_plan(root)
    print('\n====== 새 일반 지역 제목·설명 샘플 ======', flush=True)
    for brand, rel, title, desc in sample:
        print(f'[{brand}] {rel}\n제목: {title}\n설명: {desc}\n', flush=True)
    print(f'검사 완료: {len(plan):,}개 / 35,280개 중 {len(plan):,}개 조합 사용', flush=True)
    if not args.apply:
        print('미리보기 완료. 기존 HTML 수정 없음. 적용하려면 --apply를 사용하세요.', flush=True)
        return
    bak = make_backup(plan, root)
    print('실제 적용 시작. 도중에 중단되면 다시 실행하지 마시고 백업과 오류를 보존하세요.', flush=True)
    for i, (path, digest, slug, rel, title, desc) in enumerate(plan, 1):
        raw = path.read_bytes()
        insist(hashlib.sha256(raw).digest() == digest,
               f'백업 후 파일 변경: {path}')
        old = raw.decode('utf-8-sig')
        changed = change_seo(old, title, desc, f'{slug}/{rel}')
        atomic_write(path, changed)
        if i % 1000 == 0:
            print(f'수정 중: {i:,}/{len(plan):,}', flush=True)
    marker.write_text(json.dumps({
        'files': len(plan), 'backup': str(bak),
        'timestamp': datetime.now().isoformat(),
